{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++",
            "type": "shell",
            "command": "g++",
            "args": [
                "${file}",
                "-g",
                "-Wall",
                "-std=c++11",
                "-o",
                "${workspaceFolder}/out/${fileBasenameNoExtension}"
            ],
            "group": "build",
        }
    ]
}